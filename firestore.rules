rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }

    // Users: anyone authenticated can read all (for admin panels);
    //        users can create/update/delete their own doc
    //        superadmin can manage any user (app handles UI authorization)
    match /users/{userId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // Subjects: anyone authenticated can read and write
    match /subjects/{docId} {
      allow read:   if true;
      allow write:  if isAuth();
    }

    // Materials: anyone authenticated can read and write
    match /materials/{docId} {
      allow read:   if true;
      allow write:  if isAuth();
    }

    // Quizzes: anyone authenticated can read and write
    match /quizzes/{docId} {
      allow read:   if true;
      allow write:  if isAuth();
    }

    // Scores: anyone can read; users can create/update their own
    match /scores/{docId} {
      allow read:   if true;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.userId == request.auth.uid;
    }
  }
}
